DB_HOST=localhost
DB_PORT=5432
DB_USER=courselist
DB_PASS=<silne_haslo>
DB_NAME=courselist
DB_SSLMODE=disable
SESSION_TTL=24h
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=https://twoja-domena.pl
LOGIN_RATE_LIMIT=5
PORT=8082
GUS_URL=https://wyszukiwarkaregontest.stat.gov.pl/wsbir/uslugabirzewnpubl.svc
GUS_TOKEN=
NOTIFICATIONS_API_TOKEN=
# Publiczny adres API (bez /api/v1) - z niego webhook buduje pdf_url; puste pomija pdf_url.
PUBLIC_BASE_URL=
# Adres publicznej weryfikacji zaświadczenia z placeholderem {code} - pod ten adres prowadzi
# kod QR z wydruku, np. https://twoja-domena.pl/verify/{code}. Puste = kodu QR nie ma na PDF.
# Wartość bez {code} zatrzymuje start API.
CERTIFICATE_VERIFICATION_URL=
# Dispatcher webhooków (odbiorcy w tabeli webhook_endpoints). Domyślnie true.
WEBHOOKS_ENABLED=true
NOTIFICATIONS_API_BASE_URL=http://api:8082
NOTIFICATIONS_LOOKAHEAD_DAYS=30
NOTIFICATIONS_LIMIT=500
NOTIFICATIONS_RUN_INTERVAL=24h
NOTIFICATIONS_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Powiadomienia BHP
SMTP_TLS_MODE=auto
